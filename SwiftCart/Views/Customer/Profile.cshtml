@using SwiftCart.Models.ViewModels;
@model SwiftCart.Models.ViewModels.Customer.CustomerProfileViewModel

@{
    ViewData["Title"] = "My Profile";
}

<div class="container py-5">

    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold mb-1">My Profile</h1>
            <p class="text-muted mb-0">
                Manage your SwiftCart account information.
            </p>
        </div>

        <a asp-controller="Customer"
           asp-action="EditProfile"
           class="btn btn-primary">
            <i class="bi bi-pencil-square me-1"></i>
            Edit Profile
        </a>
    </div>

    <!-- Profile Card -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body p-4">

            <div class="row align-items-center">

                <!-- Profile Photo -->
                <div class="col-md-3 text-center mb-4 mb-md-0">

                    @if (!string.IsNullOrWhiteSpace(Model.ProfilePhotoUrl))
                    {
                        <img src="@Model.ProfilePhotoUrl"
                             alt="Profile Photo"
                             class="rounded-circle img-fluid"
                             style="width: 140px; height: 140px; object-fit: cover;" />
                    }
                    else
                    {
                        <div class="rounded-circle bg-light d-flex align-items-center justify-content-center mx-auto"
                             style="width: 140px; height: 140px;">

                            <i class="bi bi-person text-secondary"
                               style="font-size: 70px;"></i>

                        </div>
                    }

                </div>

                <!-- Profile Information -->
                <div class="col-md-9">

                    <h2 class="fw-bold mb-3">
                        @Model.FullName
                    </h2>

                    <div class="row">

                        <div class="col-md-6 mb-3">
                            <div class="text-muted small">
                                Email Address
                            </div>

                            <div class="fw-semibold">
                                <i class="bi bi-envelope me-2"></i>
                                @Model.Email
                            </div>
                        </div>

                        <div class="col-md-6 mb-3">
                            <div class="text-muted small">
                                Phone Number
                            </div>

                            <div class="fw-semibold">
                                <i class="bi bi-telephone me-2"></i>

                                @if (!string.IsNullOrWhiteSpace(Model.PhoneNumber))
                                {
                                    @Model.PhoneNumber
                                }
                                else
                                {
                                    <span class="text-muted">
                                        Not provided
                                    </span>
                                }

                            </div>
                        </div>

                    </div>

                </div>

            </div>

        </div>
    </div>

    <!-- Account Statistics -->
    <div class="row g-4 mb-4">

        <!-- Total Orders -->
        <div class="col-md-6">

            <div class="card shadow-sm border-0 h-100">
                <div class="card-body p-4">

                    <div class="d-flex align-items-center">

                        <div class="rounded-circle bg-primary-subtle p-3 me-3">
                            <i class="bi bi-bag-check text-primary fs-4"></i>
                        </div>

                        <div>
                            <div class="text-muted">
                                Total Orders
                            </div>

                            <h3 class="fw-bold mb-0">
                                @Model.TotalOrders
                            </h3>
                        </div>

                    </div>

                    <div class="mt-3">
                        <a asp-controller="Order"
                           asp-action="Index"
                           class="text-decoration-none">
                            View My Orders
                            <i class="bi bi-arrow-right ms-1"></i>
                        </a>
                    </div>

                </div>
            </div>

        </div>

        <!-- Saved Addresses -->
        <div class="col-md-6">

            <div class="card shadow-sm border-0 h-100">
                <div class="card-body p-4">

                    <div class="d-flex align-items-center">

                        <div class="rounded-circle bg-success-subtle p-3 me-3">
                            <i class="bi bi-geo-alt text-success fs-4"></i>
                        </div>

                        <div>
                            <div class="text-muted">
                                Saved Addresses
                            </div>

                            <h3 class="fw-bold mb-0">
                                @Model.SavedAddresses
                            </h3>
                        </div>

                    </div>

                    <div class="mt-3">
                        <a asp-controller="Customer"
                           asp-action="Addresses"
                           class="text-decoration-none">
                            Manage Addresses
                            <i class="bi bi-arrow-right ms-1"></i>
                        </a>
                    </div>

                </div>
            </div>

        </div>

    </div>

    <!-- Account Actions -->
    <div class="card shadow-sm border-0">

        <div class="card-body p-4">

            <h4 class="fw-bold mb-4">
                Account Settings
            </h4>

            <div class="row g-3">

                <div class="col-md-4">

                    <a asp-controller="Customer"
                       asp-action="EditProfile"
                       class="btn btn-outline-primary w-100 py-3">

                        <i class="bi bi-person-gear fs-5 d-block mb-1"></i>

                        Edit Profile

                    </a>

                </div>

                <div class="col-md-4">

                    <a asp-controller="Customer"
                       asp-action="Addresses"
                       class="btn btn-outline-success w-100 py-3">

                        <i class="bi bi-geo-alt fs-5 d-block mb-1"></i>

                        My Addresses

                    </a>

                </div>

                <div class="col-md-4">

                    <a asp-controller="Order"
                       asp-action="Index"
                       class="btn btn-outline-dark w-100 py-3">

                        <i class="bi bi-receipt fs-5 d-block mb-1"></i>

                        My Orders

                    </a>

                </div>

            </div>

        </div>

    </div>

</div>

