@model SwiftCart.ViewModels.AddressFormViewModel
@{
    ViewData["Title"] = "Add Address";
}

<div class="container py-4">
    <h2 class="mb-4">Add Address</h2>

    <form asp-action="AddAddress" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <partial name="_AddressForm" model="Model" />

        <button class="btn btn-primary mt-3">Save Address</button>
        <a asp-action="Addresses" class="btn btn-outline-secondary mt-3">Cancel</a>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
