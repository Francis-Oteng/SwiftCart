@model SwiftCart.ViewModels.CustomerAddressesViewModel
@{
    ViewData["Title"] = "My Addresses";
}

<div class="container py-4">
    <div class="d-flex justify-content-between mb-4">
        <h2>My Addresses</h2>
        <a asp-action="AddAddress" class="btn btn-primary">Add Address</a>
    </div>

    <div class="row g-3">
        @foreach (var address in Model.Addresses)
        {
            <div class="col-md-6">
                <div class="card shadow-sm h-100"><div class="card-body">
                    <h5>@address.Label</h5>
                    <p class="mb-1">@address.RecipientName</p>
                    <p class="mb-1">@address.PhoneNumber</p>
                    <p class="mb-1">@address.AddressLine</p>
                    <p class="mb-1">@address.City</p>
                    @if (address.IsDefault)
                    {
                        <span class="badge bg-primary">Default</span>
                    }
                    <div class="mt-3 d-flex gap-2">
                        <a asp-action="EditAddress" asp-route-id="@address.AddressId"
                           class="btn btn-outline-primary btn-sm">Edit</a>
                        <form asp-action="DeleteAddress" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@address.AddressId" />
                            <button class="btn btn-outline-danger btn-sm">Delete</button>
                        </form>
                    </div>
                </div></div>
            </div>
        }
    </div>

    @if (!Model.Addresses.Any())
    {
        <p class="text-muted">You have no saved addresses.</p>
    }
</div>