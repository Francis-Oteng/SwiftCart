@using SwiftCart.Models.ViewModels;
@model SwiftCart.Models.ViewModels.RiderDeliveryDetailsViewModel

@{
    ViewData["Title"] = "Delivery Details";
}

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2>Delivery Details</h2>
            <p class="text-muted mb-0">
                Order @Model.OrderNumber
            </p>
        </div>

        <a asp-action="MyDeliveries"
           class="btn btn-outline-secondary">
            Back
        </a>

    </div>

    <div class="row g-4">

        <div class="col-lg-8">

            <div class="card shadow-sm mb-4">
                <div class="card-header">
                    <h5 class="mb-0">Delivery Information</h5>
                </div>

                <div class="card-body">

                    <dl class="row">

                        <dt class="col-sm-4">Order</dt>
                        <dd class="col-sm-8">@Model.OrderNumber</dd>

                        <dt class="col-sm-4">Pickup</dt>
                        <dd class="col-sm-8">@Model.PickupAddress</dd>

                        <dt class="col-sm-4">Delivery</dt>
                        <dd class="col-sm-8">@Model.DeliveryAddress</dd>

                        <dt class="col-sm-4">Customer</dt>
                        <dd class="col-sm-8">@Model.CustomerName</dd>

                        <dt class="col-sm-4">Items</dt>
                        <dd class="col-sm-8">@Model.ItemCount</dd>

                        <dt class="col-sm-4">Status</dt>
                        <dd class="col-sm-8">
                            <span class="badge bg-primary">
                                @Model.Status
                            </span>
                        </dd>

                    </dl>

                </div>
            </div>

        </div>

        <div class="col-lg-4">

            <div class="card shadow-sm">

                <div class="card-header">
                    Delivery Actions
                </div>

                <div class="card-body d-grid gap-2">

                    @if (Model.CanPickUp)
                    {
                        <form asp-controller="Delivery"
                              asp-action="UpdateStatus"
                              method="post">

                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   name="id"
                                   value="@Model.DeliveryId">

                            <input type="hidden"
                                   name="status"
                                   value="PickedUp">

                            <button class="btn btn-primary w-100">
                                <i class="fas fa-box me-2"></i>
                                Pick Up
                            </button>
                        </form>
                    }

                    @if (Model.CanStartDelivery)
                    {
                        <form asp-controller="Delivery"
                              asp-action="UpdateStatus"
                              method="post">

                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   name="id"
                                   value="@Model.DeliveryId">

                            <input type="hidden"
                                   name="status"
                                   value="InTransit">

                            <button class="btn btn-warning w-100">
                                <i class="fas fa-route me-2"></i>
                                Start Delivery
                            </button>
                        </form>
                    }

                    @if (Model.CanComplete)
                    {
                        <form asp-controller="Delivery"
                              asp-action="Complete"
                              method="post">

                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   name="id"
                                   value="@Model.DeliveryId">

                            <button class="btn btn-success w-100">
                                <i class="fas fa-check me-2"></i>
                                Complete Delivery
                            </button>
                        </form>
                    }

                    <a asp-controller="Delivery"
                       asp-action="Track"
                       asp-route-id="@Model.DeliveryId"
                       class="btn btn-outline-primary">
                        Track Delivery
                    </a>

                </div>

            </div>

        </div>

    </div>
</div>
