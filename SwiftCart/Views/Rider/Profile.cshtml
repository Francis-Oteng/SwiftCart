@using SwiftCart.Models.ViewModels;
@model SwiftCart.Models.ViewModels.RiderProfileViewModel

@{
    ViewData["Title"] = "Rider Profile";
}

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Rider Profile</h2>

        <a asp-action="EditProfile" class="btn btn-primary">
            <i class="fas fa-edit me-2"></i>Edit Profile
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">

            <div class="row">

                <div class="col-md-4 text-center">
                    @if (!string.IsNullOrEmpty(Model.ProfilePhotoUrl))
                    {
                        <img src="@Model.ProfilePhotoUrl"
                             alt="Profile"
                             class="rounded-circle img-fluid mb-3"
                             style="max-width:180px;">
                    }
                    else
                    {
                        <div class="rounded-circle bg-light d-flex align-items-center justify-content-center mx-auto mb-3"
                             style="width:180px;height:180px;">
                            <i class="fas fa-user fa-5x text-secondary"></i>
                        </div>
                    }

                    <h4>@Model.FullName</h4>

                    <span class="badge @(Model.IsApproved ? "bg-success" : "bg-warning text-dark")">
                        @(Model.IsApproved ? "Approved" : "Pending Approval")
                    </span>
                </div>

                <div class="col-md-8">

                    <dl class="row">

                        <dt class="col-sm-4">Email</dt>
                        <dd class="col-sm-8">@Model.Email</dd>

                        <dt class="col-sm-4">Phone</dt>
                        <dd class="col-sm-8">@Model.PhoneNumber</dd>

                        <dt class="col-sm-4">Vehicle Type</dt>
                        <dd class="col-sm-8">@Model.VehicleType</dd>

                        <dt class="col-sm-4">Vehicle Number</dt>
                        <dd class="col-sm-8">@Model.VehicleNumber</dd>

                        <dt class="col-sm-4">Availability</dt>
                        <dd class="col-sm-8">
                            <span class="badge @(Model.IsAvailable ? "bg-success" : "bg-secondary")">
                                @(Model.IsAvailable ? "Available" : "Unavailable")
                            </span>
                        </dd>

                    </dl>

                </div>

            </div>

        </div>
    </div>
</div>