
@model SwiftCart.ViewModels.RiderDashboardViewModel

@{
    ViewData["Title"] = "Rider Dashboard";
}

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Rider Dashboard</h2>
            <p class="text-muted mb-0">Manage your deliveries and rider activity.</p>
        </div>

        <a asp-action="Profile" class="btn btn-outline-primary">
            <i class="fas fa-user me-2"></i>My Profile
        </a>
    </div>

    <div class="row g-4 mb-4">

        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <h6 class="text-muted">Active Delivery</h6>
                            <h4>@(Model.ActiveDelivery != null ? Model.ActiveDelivery.OrderNumber : "None")</h4>
                        </div>
                        <i class="fas fa-motorcycle fa-2x text-primary"></i>
                    </div>

                    @if (Model.ActiveDelivery != null)
                    {
                        <p class="mb-1">@Model.ActiveDelivery.DeliveryAddress</p>
                        <span class="badge bg-primary">
                            @Model.ActiveDelivery.Status
                        </span>

                        <div class="mt-3">
                            <a asp-controller="Rider"
                               asp-action="Details"
                               asp-route-id="@Model.ActiveDelivery.DeliveryId"
                               class="btn btn-primary btn-sm">
                                View Delivery
                            </a>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted mb-0">No active delivery.</p>
                    }
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h6 class="text-muted">Available Deliveries</h6>
                    <h3>@Model.AvailableDeliveriesCount</h3>

                    <a asp-action="AvailableDeliveries"
                       class="btn btn-outline-primary btn-sm mt-2">
                        View Available
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h6 class="text-muted">Today's Deliveries</h6>
                    <h3>@Model.TodayDeliveriesCount</h3>

                    <a asp-action="MyDeliveries"
                       class="btn btn-outline-primary btn-sm mt-2">
                        My Deliveries
                    </a>
                </div>
            </div>
        </div>

    </div>

    <div class="card shadow-sm">
        <div class="card-header">
            <h5 class="mb-0">Recent Deliveries</h5>
        </div>

        <div class="card-body p-0">

            @if (Model.RecentDeliveries != null && Model.RecentDeliveries.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead>
                            <tr>
                                <th>Order</th>
                                <th>Pickup</th>
                                <th>Delivery</th>
                                <th>Status</th>
                                <th></th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var delivery in Model.RecentDeliveries)
                            {
                                <tr>
                                    <td>@delivery.OrderNumber</td>
                                    <td>@delivery.PickupAddress</td>
                                    <td>@delivery.DeliveryAddress</td>
                                    <td>
                                        <span class="badge bg-secondary">
                                            @delivery.Status
                                        </span>
                                    </td>
                                    <td>
                                        <a asp-action="Details"
                                           asp-route-id="@delivery.DeliveryId"
                                           class="btn btn-sm btn-outline-primary">
                                            Details
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="p-4 text-center text-muted">
                    No recent deliveries found.
                </div>
            }

        </div>
    </div>
</div>
