@model SwiftCart.ViewModels.AvailableDeliveriesViewModel

@{
    ViewData["Title"] = "Available Deliveries";
}

<div class="container py-4">

    <div class="mb-4">
        <h2>Available Deliveries</h2>
        <p class="text-muted">
            Deliveries currently waiting for a rider.
        </p>
    </div>

    @if (Model.Deliveries != null && Model.Deliveries.Any())
    {
        <div class="row g-4">

            @foreach (var delivery in Model.Deliveries)
            {
                <div class="col-md-6 col-lg-4">

                    <div class="card shadow-sm h-100">

                        <div class="card-body">

                            <div class="d-flex justify-content-between mb-3">
                                <h5>@delivery.OrderNumber</h5>

                                <span class="badge bg-warning text-dark">
                                    @delivery.Status
                                </span>
                            </div>

                            <p>
                                <strong>Pickup:</strong><br>
                                @delivery.PickupAddress
                            </p>

                            <p>
                                <strong>Delivery:</strong><br>
                                @delivery.DeliveryAddress
                            </p>

                            <p>
                                <strong>Items:</strong>
                                @delivery.ItemCount
                            </p>

                            <a asp-action="Details"
                               asp-route-id="@delivery.DeliveryId"
                               class="btn btn-primary w-100">
                                View Details
                            </a>

                        </div>
                    </div>

                </div>
            }

        </div>
    }
    else
    {
        <div class="alert alert-info">
            There are currently no available deliveries.
        </div>
    }

</div>
