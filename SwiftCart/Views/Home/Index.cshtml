@using SwiftCart.Models.ViewModels.Home;
@model SwiftCart.Models.ViewModels.Home.IndexViewModel

@{
    ViewData["Title"] = "Home";
}

<!-- =========================
     HERO SECTION
========================= -->
<section class="swiftcart-hero py-5">
    <div class="container py-lg-5">

        <div class="row align-items-center">

            <!-- Hero Text -->
            <div class="col-lg-6 mb-5 mb-lg-0">

                <span class="badge bg-success-subtle text-success px-3 py-2 rounded-pill mb-3">
                    <i class="fa-solid fa-bolt me-1"></i>
                    Fast & Reliable Grocery Delivery
                </span>

                <h1 class="display-3 fw-bold mb-4">
                    Groceries delivered
                    <span class="text-success">swiftly.</span>
                </h1>

                <p class="lead text-muted mb-4">
                    Shop your favorite groceries from local stores and get
                    everything delivered straight to your doorstep.
                </p>

                <!-- Search -->
                <form asp-controller="Product"
                      asp-action="Index"
                      method="get"
                      class="mb-4">

                    <div class="input-group input-group-lg shadow-sm">

                        <span class="input-group-text bg-white border-end-0">
                            <i class="fa-solid fa-magnifying-glass text-muted"></i>
                        </span>

                        <input type="text"
                               name="search"
                               class="form-control border-start-0"
                               placeholder="Search for groceries..." />

                        <button type="submit"
                                class="btn btn-success px-4">
                            Search
                        </button>

                    </div>

                </form>

                <!-- Buttons -->
                <div class="d-flex flex-wrap gap-3">

                    <a asp-controller="Store"
                       asp-action="Index"
                       class="btn btn-success btn-lg px-4">

                        <i class="fa-solid fa-store me-2"></i>
                        Browse Stores

                    </a>

                    <a asp-controller="Product"
                       asp-action="Index"
                       class="btn btn-outline-success btn-lg px-4">

                        Explore Groceries

                    </a>

                </div>

            </div>


            <!-- Hero Illustration -->
            <div class="col-lg-6 text-center">

                <div class="swiftcart-hero-image bg-success-subtle rounded-5 p-5">

                    <i class="fa-solid fa-basket-shopping text-success"
                       style="font-size: 150px;"></i>

                    <div class="mt-4">

                        <div class="bg-white rounded-4 shadow-sm p-3 d-inline-flex align-items-center">

                            <div class="bg-success-subtle rounded-circle p-3 me-3">

                                <i class="fa-solid fa-motorcycle text-success fs-4"></i>

                            </div>

                            <div class="text-start">

                                <small class="text-muted d-block">
                                    Delivery
                                </small>

                                <strong>
                                    On its way!
                                </strong>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>
</section>


<!-- =========================
     QUICK FEATURES
========================= -->
<section class="py-5">

    <div class="container">

        <div class="row g-4">

            <div class="col-md-4">

                <div class="d-flex align-items-center">

                    <div class="bg-success-subtle rounded-circle p-3 me-3">

                        <i class="fa-solid fa-truck-fast text-success fs-4"></i>

                    </div>

                    <div>

                        <h6 class="fw-bold mb-1">
                            Fast Delivery
                        </h6>

                        <small class="text-muted">
                            Get your groceries delivered quickly.
                        </small>

                    </div>

                </div>

            </div>


            <div class="col-md-4">

                <div class="d-flex align-items-center">

                    <div class="bg-success-subtle rounded-circle p-3 me-3">

                        <i class="fa-solid fa-store text-success fs-4"></i>

                    </div>

                    <div>

                        <h6 class="fw-bold mb-1">
                            Local Stores
                        </h6>

                        <small class="text-muted">
                            Shop from stores around you.
                        </small>

                    </div>

                </div>

            </div>


            <div class="col-md-4">

                <div class="d-flex align-items-center">

                    <div class="bg-success-subtle rounded-circle p-3 me-3">

                        <i class="fa-solid fa-location-dot text-success fs-4"></i>

                    </div>

                    <div>

                        <h6 class="fw-bold mb-1">
                            Track Your Order
                        </h6>

                        <small class="text-muted">
                            Follow your delivery in real time.
                        </small>

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>


<!-- =========================
     CATEGORIES
========================= -->
<section class="py-5 bg-light">

    <div class="container">

        <div class="d-flex justify-content-between align-items-center mb-4">

            <div>

                <h2 class="fw-bold mb-1">
                    Shop by Category
                </h2>

                <p class="text-muted mb-0">
                    Find everything you need in one place.
                </p>

            </div>

            <a asp-controller="Product"
               asp-action="Index"
               class="text-success text-decoration-none fw-semibold">

                View All
                <i class="fa-solid fa-arrow-right ms-1"></i>

            </a>

        </div>


        <div class="row g-4">

            <!-- Fruits -->
            <div class="col-6 col-md-3">

                <a asp-controller="Product"
                   asp-action="Index"
                   asp-route-category="Fruits"
                   class="text-decoration-none">

                    <div class="card border-0 shadow-sm text-center p-4 h-100">

                        <div class="bg-success-subtle rounded-circle d-inline-flex
                                    align-items-center justify-content-center mx-auto mb-3"
                             style="width:80px;height:80px;">

                            <i class="fa-solid fa-apple-whole text-success fs-2"></i>

                        </div>

                        <h5 class="fw-bold text-dark">
                            Fruits
                        </h5>

                        <p class="text-muted small mb-0">
                            Fresh fruits
                        </p>

                    </div>

                </a>

            </div>


            <!-- Vegetables -->
            <div class="col-6 col-md-3">

                <a asp-controller="Product"
                   asp-action="Index"
                   asp-route-category="Vegetables"
                   class="text-decoration-none">

                    <div class="card border-0 shadow-sm text-center p-4 h-100">

                        <div class="bg-success-subtle rounded-circle d-inline-flex
                                    align-items-center justify-content-center mx-auto mb-3"
                             style="width:80px;height:80px;">

                            <i class="fa-solid fa-carrot text-success fs-2"></i>

                        </div>

                        <h5 class="fw-bold text-dark">
                            Vegetables
                        </h5>

                        <p class="text-muted small mb-0">
                            Fresh vegetables
                        </p>

                    </div>

                </a>

            </div>


            <!-- Meat -->
            <div class="col-6 col-md-3">

                <a asp-controller="Product"
                   asp-action="Index"
                   asp-route-category="Meat"
                   class="text-decoration-none">

                    <div class="card border-0 shadow-sm text-center p-4 h-100">

                        <div class="bg-success-subtle rounded-circle d-inline-flex
                                    align-items-center justify-content-center mx-auto mb-3"
                             style="width:80px;height:80px;">

                            <i class="fa-solid fa-drumstick-bite text-success fs-2"></i>

                        </div>

                        <h5 class="fw-bold text-dark">
                            Meat
                        </h5>

                        <p class="text-muted small mb-0">
                            Meat & poultry
                        </p>

                    </div>

                </a>

            </div>


            <!-- Drinks -->
            <div class="col-6 col-md-3">

                <a asp-controller="Product"
                   asp-action="Index"
                   asp-route-category="Drinks"
                   class="text-decoration-none">

                    <div class="card border-0 shadow-sm text-center p-4 h-100">

                        <div class="bg-success-subtle rounded-circle d-inline-flex
                                    align-items-center justify-content-center mx-auto mb-3"
                             style="width:80px;height:80px;">

                            <i class="fa-solid fa-bottle-water text-success fs-2"></i>

                        </div>

                        <h5 class="fw-bold text-dark">
                            Drinks
                        </h5>

                        <p class="text-muted small mb-0">
                            Drinks & beverages
                        </p>

                    </div>

                </a>

            </div>

        </div>

    </div>

</section>


<!-- =========================
     POPULAR STORES
========================= -->
<section class="py-5">

    <div class="container">

        <div class="d-flex justify-content-between align-items-center mb-4">

            <div>

                <h2 class="fw-bold mb-1">
                    Popular Stores
                </h2>

                <p class="text-muted mb-0">
                    Discover stores available on SwiftCart.
                </p>

            </div>

            <a asp-controller="Store"
               asp-action="Index"
               class="text-success text-decoration-none fw-semibold">

                View All
                <i class="fa-solid fa-arrow-right ms-1"></i>

            </a>

        </div>


        <div class="row g-4">

            <!-- Store 1 -->
            <div class="col-md-4">

                <div class="card border-0 shadow-sm h-100">

                    <div class="bg-light p-5 text-center">

                        <i class="fa-solid fa-store text-success"
                           style="font-size:60px;"></i>

                    </div>

                    <div class="card-body p-4">

                        <div class="d-flex justify-content-between align-items-start">

                            <div>

                                <h5 class="fw-bold mb-1">
                                    Swift Fresh Market
                                </h5>

                                <small class="text-muted">
                                    Groceries & Fresh Produce
                                </small>

                            </div>

                            <span class="badge bg-success">
                                4.8 ★
                            </span>

                        </div>

                        <p class="text-muted small mt-3 mb-3">

                            <i class="fa-solid fa-location-dot me-1"></i>

                            Available for delivery

                        </p>

                        <a asp-controller="Store"
                           asp-action="Index"
                           class="btn btn-outline-success w-100">

                            Visit Store

                        </a>

                    </div>

                </div>

            </div>


            <!-- Store 2 -->
            <div class="col-md-4">

                <div class="card border-0 shadow-sm h-100">

                    <div class="bg-light p-5 text-center">

                        <i class="fa-solid fa-basket-shopping text-success"
                           style="font-size:60px;"></i>

                    </div>

                    <div class="card-body p-4">

                        <div class="d-flex justify-content-between align-items-start">

                            <div>

                                <h5 class="fw-bold mb-1">
                                    Fresh Basket
                                </h5>

                                <small class="text-muted">
                                    Fruits & Vegetables
                                </small>

                            </div>

                            <span class="badge bg-success">
                                4.7 ★
                            </span>

                        </div>

                        <p class="text-muted small mt-3 mb-3">

                            <i class="fa-solid fa-location-dot me-1"></i>

                            Available for delivery

                        </p>

                        <a asp-controller="Store"
                           asp-action="Index"
                           class="btn btn-outline-success w-100">

                            Visit Store

                        </a>

                    </div>

                </div>

            </div>


            <!-- Store 3 -->
            <div class="col-md-4">

                <div class="card border-0 shadow-sm h-100">

                    <div class="bg-light p-5 text-center">

                        <i class="fa-solid fa-shop text-success"
                           style="font-size:60px;"></i>

                    </div>

                    <div class="card-body p-4">

                        <div class="d-flex justify-content-between align-items-start">

                            <div>

                                <h5 class="fw-bold mb-1">
                                    Daily Needs
                                </h5>

                                <small class="text-muted">
                                    Household Essentials
                                </small>

                            </div>

                            <span class="badge bg-success">
                                4.6 ★
                            </span>

                        </div>

                        <p class="text-muted small mt-3 mb-3">

                            <i class="fa-solid fa-location-dot me-1"></i>

                            Available for delivery

                        </p>

                        <a asp-controller="Store"
                           asp-action="Index"
                           class="btn btn-outline-success w-100">

                            Visit Store

                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>


<!-- =========================
     HOW IT WORKS
========================= -->
<section class="py-5 bg-light">

    <div class="container">

        <div class="text-center mb-5">

            <h2 class="fw-bold">
                How SwiftCart Works
            </h2>

            <p class="text-muted">
                Getting your groceries delivered is easy.
            </p>

        </div>


        <div class="row g-4">

            <div class="col-md-3 text-center">

                <div class="bg-success text-white rounded-circle
                            d-flex align-items-center justify-content-center
                            mx-auto mb-3"
                     style="width:70px;height:70px;">

                    <i class="fa-solid fa-store fs-4"></i>

                </div>

                <h5 class="fw-bold">
                    1. Choose a Store
                </h5>

                <p class="text-muted small">
                    Browse stores available in your area.
                </p>

            </div>


            <div class="col-md-3 text-center">

                <div class="bg-success text-white rounded-circle
                            d-flex align-items-center justify-content-center
                            mx-auto mb-3"
                     style="width:70px;height:70px;">

                    <i class="fa-solid fa-cart-plus fs-4"></i>

                </div>

                <h5 class="fw-bold">
                    2. Add to Cart
                </h5>

                <p class="text-muted small">
                    Select the groceries you want to purchase.
                </p>

            </div>


            <div class="col-md-3 text-center">

                <div class="bg-success text-white rounded-circle
                            d-flex align-items-center justify-content-center
                            mx-auto mb-3"
                     style="width:70px;height:70px;">

                    <i class="fa-solid fa-credit-card fs-4"></i>

                </div>

                <h5 class="fw-bold">
                    3. Checkout
                </h5>

                <p class="text-muted small">
                    Confirm your address and complete your order.
                </p>

            </div>


            <div class="col-md-3 text-center">

                <div class="bg-success text-white rounded-circle
                            d-flex align-items-center justify-content-center
                            mx-auto mb-3"
                     style="width:70px;height:70px;">

                    <i class="fa-solid fa-motorcycle fs-4"></i>

                </div>

                <h5 class="fw-bold">
                    4. Get Delivered
                </h5>

                <p class="text-muted small">
                    Track your rider and receive your groceries.
                </p>

            </div>

        </div>

    </div>

</section>


<!-- =========================
     FINAL CTA
========================= -->
<section class="py-5">

    <div class="container">

        <div class="bg-success text-white rounded-5 p-5 text-center">

            <i class="fa-solid fa-basket-shopping fs-1 mb-3"></i>

            <h2 class="fw-bold">
                Ready to start shopping?
            </h2>

            <p class="mb-4">
                Find your favorite groceries and get them delivered with SwiftCart.
            </p>

            <a asp-controller="Store"
               asp-action="Index"
               class="btn btn-light btn-lg px-4">

                <i class="fa-solid fa-store me-2"></i>
                Browse Stores

            </a>

        </div>

    </div>

</section>

