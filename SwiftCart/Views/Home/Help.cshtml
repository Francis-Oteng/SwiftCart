@{
    ViewData["Title"] = "Help Centre";
}

<div class="container py-5">

    <!-- Header -->
    <div class="text-center mb-5">
        <span class="badge bg-success-subtle text-success px-3 py-2 mb-3">
            SwiftCart Support
        </span>

        <h1 class="display-5 fw-bold">How can we help?</h1>

        <p class="text-muted mx-auto" style="max-width: 650px;">
            Find answers to common questions about shopping, orders, payments,
            deliveries and your SwiftCart account.
        </p>
    </div>

    <!-- Search -->
    <div class="row justify-content-center mb-5">
        <div class="col-lg-7">
            <div class="input-group input-group-lg shadow-sm">
                <span class="input-group-text bg-white border-end-0">
                    <i class="fa-solid fa-magnifying-glass text-muted"></i>
                </span>

                <input type="text"
                       class="form-control border-start-0"
                       placeholder="Search for help..." />

                <button class="btn btn-success">
                    Search
                </button>
            </div>
        </div>
    </div>

    <!-- Help Categories -->
    <div class="row g-4 mb-5">

        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100 p-4">
                <i class="fa-solid fa-cart-shopping text-success fs-2 mb-3"></i>

                <h4 class="fw-bold">Orders & Shopping</h4>

                <p class="text-muted">
                    Learn how to browse stores, add products to your cart and
                    place an order.
                </p>

                <a href="#orders" class="text-success text-decoration-none fw-semibold">
                    Learn more <i class="fa-solid fa-arrow-right ms-1"></i>
                </a>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100 p-4">
                <i class="fa-solid fa-truck-fast text-success fs-2 mb-3"></i>

                <h4 class="fw-bold">Delivery</h4>

                <p class="text-muted">
                    Find information about delivery status, riders and
                    tracking your order.
                </p>

                <a href="#delivery" class="text-success text-decoration-none fw-semibold">
                    Learn more <i class="fa-solid fa-arrow-right ms-1"></i>
                </a>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100 p-4">
                <i class="fa-solid fa-credit-card text-success fs-2 mb-3"></i>

                <h4 class="fw-bold">Payments</h4>

                <p class="text-muted">
                    Get help with payments, checkout and order confirmation.
                </p>

                <a href="#payments" class="text-success text-decoration-none fw-semibold">
                    Learn more <i class="fa-solid fa-arrow-right ms-1"></i>
                </a>
            </div>
        </div>

    </div>

    <!-- FAQ -->
    <div class="row justify-content-center">

        <div class="col-lg-9">

            <h2 class="fw-bold text-center mb-4">
                Frequently Asked Questions
            </h2>

            <div class="accordion shadow-sm" id="faqAccordion">

                <!-- FAQ 1 -->
                <div class="accordion-item">
                    <h2 class="accordion-header">
                        <button class="accordion-button fw-semibold"
                                type="button"
                                data-bs-toggle="collapse"
                                data-bs-target="#faqOne">
                            How do I place an order?
                        </button>
                    </h2>

                    <div id="faqOne"
                         class="accordion-collapse collapse show"
                         data-bs-parent="#faqAccordion">

                        <div class="accordion-body text-muted">
                            Browse the available stores, select the products
                            you want, add them to your cart and proceed to
                            checkout.
                        </div>

                    </div>
                </div>

                <!-- FAQ 2 -->
                <div class="accordion-item">
                    <h2 class="accordion-header">
                        <button class="accordion-button collapsed fw-semibold"
                                type="button"
                                data-bs-toggle="collapse"
                                data-bs-target="#faqTwo">
                            How can I track my order?
                        </button>
                    </h2>

                    <div id="faqTwo"
                         class="accordion-collapse collapse"
                         data-bs-parent="#faqAccordion">

                        <div class="accordion-body text-muted">
                            Once your order has been accepted and assigned for
                            delivery, you can use the order tracking section
                            to view its current status.
                        </div>

                    </div>
                </div>

                <!-- FAQ 3 -->
                <div class="accordion-item">
                    <h2 class="accordion-header">
                        <button class="accordion-button collapsed fw-semibold"
                                type="button"
                                data-bs-toggle="collapse"
                                data-bs-target="#faqThree">
                            Can I cancel my order?
                        </button>
                    </h2>

                    <div id="faqThree"
                         class="accordion-collapse collapse"
                         data-bs-parent="#faqAccordion">

                        <div class="accordion-body text-muted">
                            Order cancellation depends on the current status
                            of your order. Check your order details for the
                            available cancellation options.
                        </div>

                    </div>
                </div>

                <!-- FAQ 4 -->
                <div class="accordion-item">
                    <h2 class="accordion-header">
                        <button class="accordion-button collapsed fw-semibold"
                                type="button"
                                data-bs-toggle="collapse"
                                data-bs-target="#faqFour">
                            What if my order is late?
                        </button>
                    </h2>

                    <div id="faqFour"
                         class="accordion-collapse collapse"
                         data-bs-parent="#faqAccordion">

                        <div class="accordion-body text-muted">
                            Check your order tracking information first. If
                            you still need assistance, contact SwiftCart
                            support.
                        </div>

                    </div>
                </div>

                <!-- FAQ 5 -->
                <div class="accordion-item">
                    <h2 class="accordion-header">
                        <button class="accordion-button collapsed fw-semibold"
                                type="button"
                                data-bs-toggle="collapse"
                                data-bs-target="#faqFive">
                            How do I contact SwiftCart support?
                        </button>
                    </h2>

                    <div id="faqFive"
                         class="accordion-collapse collapse"
                         data-bs-parent="#faqAccordion">

                        <div class="accordion-body text-muted">
                            You can contact the SwiftCart support team through
                            the support information provided below.
                        </div>

                    </div>
                </div>

            </div>

        </div>

    </div>

    <!-- Contact Support -->
    <div class="bg-success-subtle rounded-4 p-5 text-center mt-5">

        <i class="fa-solid fa-headset text-success fs-1 mb-3"></i>

        <h3 class="fw-bold">Still need help?</h3>

        <p class="text-muted">
            Our support team is here to help you with your SwiftCart experience.
        </p>

        <a href="mailto:support@swiftcart.com"
           class="btn btn-success px-4">
            <i class="fa-solid fa-envelope me-2"></i>
            Contact Support
        </a>

    </div>

</div>

