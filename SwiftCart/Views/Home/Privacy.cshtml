@{
    ViewData["Title"] = "Privacy Policy";
}

<div class="container py-5">

    <!-- Header -->
    <div class="text-center mb-5">
        <span class="badge bg-success-subtle text-success px-3 py-2 mb-3">
            SwiftCart Privacy
        </span>

        <h1 class="display-5 fw-bold">Privacy Policy</h1>

        <p class="text-muted">
            Your privacy and the security of your information matter to us.
        </p>
    </div>

    <div class="row justify-content-center">

        <div class="col-lg-9">

            <div class="card border-0 shadow-sm">

                <div class="card-body p-4 p-lg-5">

                    <p class="text-muted">
                        <strong>Last updated:</strong> @DateTime.Now.ToString("MMMM dd, yyyy")
                    </p>

                    <p>
                        SwiftCart is committed to protecting the privacy of
                        customers, store owners, riders and other users of the
                        platform. This Privacy Policy explains the types of
                        information that may be collected and how that
                        information may be used.
                    </p>

                    <hr class="my-4" />

                    <!-- 1 -->
                    <h3 class="fw-bold mb-3">
                        1. Information We Collect
                    </h3>

                    <p>
                        When you use SwiftCart, we may collect information
                        necessary to provide our services, including:
                    </p>

                    <ul>
                        <li>Name and account information</li>
                        <li>Email address and phone number</li>
                        <li>Delivery addresses</li>
                        <li>Order and transaction information</li>
                        <li>Products purchased through the platform</li>
                        <li>Account and login information</li>
                    </ul>

                    <!-- 2 -->
                    <h3 class="fw-bold mt-5 mb-3">
                        2. How We Use Your Information
                    </h3>

                    <p>
                        Information collected through SwiftCart may be used to:
                    </p>

                    <ul>
                        <li>Create and manage your SwiftCart account.</li>
                        <li>Process and manage grocery orders.</li>
                        <li>Coordinate deliveries.</li>
                        <li>Provide order tracking information.</li>
                        <li>Communicate with you about your orders.</li>
                        <li>Improve the SwiftCart platform and services.</li>
                    </ul>

                    <!-- 3 -->
                    <h3 class="fw-bold mt-5 mb-3">
                        3. Account Security
                    </h3>

                    <p>
                        Users are responsible for maintaining the
                        confidentiality of their account credentials. You should
                        not share your password or other login credentials with
                        other people.
                    </p>

                    <p>
                        If you believe that your account has been accessed
                        without authorization, contact SwiftCart support as
                        soon as possible.
                    </p>

                    <!-- 4 -->
                    <h3 class="fw-bold mt-5 mb-3">
                        4. Order and Delivery Information
                    </h3>

                    <p>
                        Information required to complete an order, such as your
                        delivery address and order details, may be shared with
                        the relevant store and delivery personnel where
                        necessary to fulfill your order.
                    </p>

                    <!-- 5 -->
                    <h3 class="fw-bold mt-5 mb-3">
                        5. Payments
                    </h3>

                    <p>
                        Payment information is used to process transactions
                        associated with your SwiftCart orders. SwiftCart should
                        only retain payment information where necessary for
                        legitimate business and operational purposes.
                    </p>

                    <!-- 6 -->
                    <h3 class="fw-bold mt-5 mb-3">
                        6. Cookies and Similar Technologies
                    </h3>

                    <p>
                        SwiftCart may use cookies or similar technologies to
                        maintain sessions, remember preferences and improve the
                        functionality of the platform.
                    </p>

                    <!-- 7 -->
                    <h3 class="fw-bold mt-5 mb-3">
                        7. Third-Party Services
                    </h3>

                    <p>
                        SwiftCart may integrate with third-party services such
                        as payment providers, mapping services, communication
                        providers or other technologies required to operate
                        the platform.
                    </p>

                    <!-- 8 -->
                    <h3 class="fw-bold mt-5 mb-3">
                        8. Changes to This Policy
                    </h3>

                    <p>
                        This Privacy Policy may be updated from time to time as
                        SwiftCart develops its services. Changes will be
                        reflected on this page.
                    </p>

                    <!-- 9 -->
                    <h3 class="fw-bold mt-5 mb-3">
                        9. Contact Us
                    </h3>

                    <p>
                        If you have questions about this Privacy Policy or how
                        your information is handled, please contact the
                        SwiftCart support team.
                    </p>

                    <a href="mailto:support@swiftcart.com"
                       class="btn btn-success mt-2">
                        <i class="fa-solid fa-envelope me-2"></i>
                        Contact SwiftCart
                    </a>

                </div>

            </div>

        </div>

    </div>

</div>

