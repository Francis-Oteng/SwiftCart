@model SwiftCart.Models.ViewModels.Order.OrderTrackingViewModel

@{
    ViewData["Title"] = "Track Order";
}

<div class="container py-4">

    <h2>Track Order</h2>

    <p class="text-muted">
        @Model.OrderNumber
    </p>

    <div class="card shadow-sm">
        <div class="card-body">

            <h5>
                Current Status:
                <span class="badge bg-primary">
                    @Model.Status
                </span>
            </h5>

            <p>
                <strong>Delivery address:</strong>
                @Model.DeliveryAddress
            </p>

            <hr />

            <h5 class="mb-4">Order Progress</h5>

            @foreach (var step in Model.Steps)
            {
                <div class="d-flex gap-3 mb-4">

                    <div>
                        @if (step.IsCompleted)
                        {
                            <i class="fas fa-check-circle fa-lg text-success"></i>
                        }
                        else if (step.IsCurrent)
                        {
                            <i class="fas fa-circle-dot fa-lg text-primary"></i>
                        }
                        else
                        {
                            <i class="far fa-circle fa-lg text-secondary"></i>
                        }
                    </div>

                    <div>
                        <strong>@step.Title</strong>

                        @if (!string.IsNullOrWhiteSpace(step.Description))
                        {
                            <p class="text-muted mb-1">
                                @step.Description
                            </p>
                        }

                        @if (step.Timestamp.HasValue)
                        {
                            <small class="text-muted">
                                @step.Timestamp.Value.ToLocalTime()
                            </small>
                        }
                    </div>

                </div>
            }

            @if (Model.DeliveryId.HasValue)
            {
                <a asp-controller="Delivery"
                   asp-action="Track"
                   asp-route-id="@Model.DeliveryId.Value"
                   class="btn btn-outline-primary">
                    View Delivery Tracking
                </a>
            }

        </div>
    </div>

</div>

