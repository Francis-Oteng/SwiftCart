@model SwiftCart.ViewModels.OrderDetailsViewModel
@{
    ViewData["Title"] = "Order Details";
}

<div class="container py-4">
    <div class="d-flex justify-content-between mb-4">
        <h2>Order Details</h2>
        <a asp-action="Index" class="btn btn-outline-secondary">Back to Orders</a>
    </div>

    <div class="card shadow-sm mb-4"><div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Order Number</dt><dd class="col-sm-9">@Model.OrderNumber</dd>
            <dt class="col-sm-3">Order Date</dt><dd class="col-sm-9">@Model.CreatedDate</dd>
            <dt class="col-sm-3">Status</dt><dd class="col-sm-9">@Model.Status</dd>
            <dt class="col-sm-3">Delivery Address</dt><dd class="col-sm-9">@Model.DeliveryAddress</dd>
            <dt class="col-sm-3">Payment Status</dt><dd class="col-sm-9">@Model.PaymentStatus</dd>
        </dl>
    </div></div>

    <div class="card shadow-sm"><div class="card-header">Items</div>
        <div class="card-body p-0">
            <table class="table mb-0">
                <thead><tr><th>Product</th><th>Quantity</th><th>Unit Price</th><th>Subtotal</th></tr></thead>
                <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td>@item.ProductName</td>
                        <td>@item.Quantity</td>
                        <td>@item.UnitPrice.ToString("C")</td>
                        <td>@item.Subtotal.ToString("C")</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
        <div class="card-footer text-end">
            <p>Subtotal: @Model.Subtotal.ToString("C")</p>
            <p>Delivery: @Model.DeliveryFee.ToString("C")</p>
            <h5>Total: @Model.Total.ToString("C")</h5>
            <a asp-action="Track" asp-route-id="@Model.OrderId"
               class="btn btn-primary">Track Order</a>
        </div>
    </div>
</div>