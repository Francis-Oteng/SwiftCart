@using SwiftCart.Models.ViewModels;
@model SwiftCart.Models.ViewModels.Order.OrderListViewModel
@{
    ViewData["Title"] = "My Orders";
}

<div class="container py-4">
    <h2 class="mb-4">My Orders</h2>

    <div class="card shadow-sm"><div class="card-body p-0">
        @if (Model.Orders.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr><th>Order</th><th>Date</th><th>Total</th><th>Status</th><th></th></tr>
                    </thead>
                    <tbody>
                    @foreach (var order in Model.Orders)
                    {
                        <tr>
                            <td>@order.OrderNumber</td>
                            <td>@order.CreatedDate</td>
                            <td>@order.Total.ToString("C")</td>
                            <td>@order.Status</td>
                            <td>
                                <a asp-action="Details" asp-route-id="@order.OrderId"
                                   class="btn btn-sm btn-outline-primary">Details</a>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <p class="p-4 mb-0 text-muted">You have no orders yet.</p>
        }
    </div></div>
</div>


