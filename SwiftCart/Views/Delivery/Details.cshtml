@using SwiftCart.Models.ViewModels.Delivery;
@model SwiftCart.Models.ViewModels.Delivery.DetailsViewModel

@{
    ViewData["Title"] = "Delivery Details";
}

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2>Delivery Details</h2>
            <p class="text-muted mb-0">
                @Model.OrderNumber
            </p>
        </div>

        <a asp-action="Track"
           asp-route-id="@Model.DeliveryId"
           class="btn btn-primary">
            <i class="fas fa-map-marker-alt me-2"></i>
            Track Delivery
        </a>

    </div>

    <div class="row g-4">

        <div class="col-lg-8">

            <div class="card shadow-sm mb-4">

                <div class="card-header">
                    <h5 class="mb-0">Delivery Information</h5>
                </div>

                <div class="card-body">

                    <dl class="row">

                        <dt class="col-sm-4">Order</dt>
                        <dd class="col-sm-8">@Model.OrderNumber</dd>

                        <dt class="col-sm-4">Pickup</dt>
                        <dd class="col-sm-8">@Model.PickupAddress</dd>

                        <dt class="col-sm-4">Delivery</dt>
                        <dd class="col-sm-8">@Model.DeliveryAddress</dd>

                        <dt class="col-sm-4">Customer</dt>
                        <dd class="col-sm-8">@Model.CustomerName</dd>

                        <dt class="col-sm-4">Items</dt>
                        <dd class="col-sm-8">@Model.ItemCount</dd>

                        <dt class="col-sm-4">Status</dt>
                        <dd class="col-sm-8">
                            <span class="badge bg-primary">
                                @Model.Status
                            </span>
                        </dd>

                        <dt class="col-sm-4">Delivery Fee</dt>
                        <dd class="col-sm-8">
                            @Model.DeliveryFee.ToString("C")
                        </dd>

                    </dl>

                </div>
            </div>

            @if (Model.Rider != null)
            {
                <div class="card shadow-sm">

                    <div class="card-header">
                        <h5 class="mb-0">Rider</h5>
                    </div>

                    <div class="card-body">

                        <p class="mb-1">
                            <strong>@Model.Rider.Name</strong>
                        </p>

                        <p class="mb-1">
                            Vehicle: @Model.Rider.VehicleType
                        </p>

                        <p class="mb-0">
                            @Model.Rider.VehicleNumber
                        </p>

                    </div>
                </div>
            }

        </div>

        <div class="col-lg-4">

            <div class="card shadow-sm">

                <div class="card-header">
                    Status
                </div>

                <div class="card-body">

                    <h5>@Model.Status</h5>

                    @if (Model.AssignedAt.HasValue)
                    {
                        <p class="text-muted">
                            Assigned: @Model.AssignedAt
                        </p>
                    }

                    @if (Model.PickedUpAt.HasValue)
                    {
                        <p class="text-muted">
                            Picked up: @Model.PickedUpAt
                        </p>
                    }

                    @if (Model.DeliveredAt.HasValue)
                    {
                        <p class="text-muted">
                            Delivered: @Model.DeliveredAt
                        </p>
                    }

                </div>
            </div>

        </div>

    </div>
</div>

