@model SwiftCart.ViewModels.CompletedDeliveryViewModel

@{
    ViewData["Title"] = "Delivery Completed";
}

<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-md-7">

            <div class="card shadow-sm text-center">

                <div class="card-body p-5">

                    <i class="fas fa-check-circle fa-5x text-success mb-4"></i>

                    <h2>Delivery Completed</h2>

                    <p class="lead">
                        @Model.OrderNumber
                    </p>

                    <p class="text-muted">
                        The delivery has been successfully completed.
                    </p>

                    <dl class="row text-start mt-4">

                        <dt class="col-sm-5">Customer</dt>
                        <dd class="col-sm-7">@Model.CustomerName</dd>

                        <dt class="col-sm-5">Delivered At</dt>
                        <dd class="col-sm-7">@Model.DeliveredAt</dd>

                        <dt class="col-sm-5">Delivery Address</dt>
                        <dd class="col-sm-7">@Model.DeliveryAddress</dd>

                    </dl>

                    @if (Model.CanReview)
                    {
                        <a asp-controller="Review"
                           asp-action="Create"
                           asp-route-orderId="@Model.OrderId"
                           class="btn btn-primary">
                            Leave a Review
                        </a>
                    }

                </div>
            </div>

        </div>

    </div>

</div>

