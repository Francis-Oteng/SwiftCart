@using SwiftCart.Models.ViewModels;
@model SwiftCart.Models.ViewModels.ProductListViewModel
@{
    ViewData["Title"] = "My Products";
}

<div class="container py-4">
    <div class="d-flex justify-content-between mb-4">
        <h2>My Products</h2>
        <a asp-action="Create" class="btn btn-primary">Add Product</a>
    </div>

    <div class="card shadow-sm"><div class="card-body p-0">
        <div class="table-responsive">
            <table class="table mb-0">
                <thead><tr><th>Product</th><th>Category</th><th>Price</th><th>Stock</th><th>Status</th><th></th></tr></thead>
                <tbody>
                @foreach (var product in Model.Products)
                {
                    <tr>
                        <td>@product.Name</td>
                        <td>@product.CategoryName</td>
                        <td>@product.Price.ToString("C")</td>
                        <td>@product.AvailableStock</td>
                        <td>@product.Status</td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@product.ProductId"
                               class="btn btn-sm btn-outline-primary">Edit</a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div></div>

    @if (!Model.Products.Any())
    {
        <p class="text-muted mt-3">You have not added any products.</p>
    }
</div>