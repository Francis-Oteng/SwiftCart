@using SwiftCart.Models.ViewModels;
@model SwiftCart.Models.ViewModels.ProductFormViewModel
@{
    ViewData["Title"] = "Create Product";
}

<div class="container py-4">
    <h2>Create Product</h2>

    <form asp-action="Create" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <partial name="_ProductForm" model="Model" />

        <button class="btn btn-primary mt-3">Create Product</button>
        <a asp-action="MyProducts" class="btn btn-outline-secondary mt-3">Cancel</a>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}


