@model SwiftCart.ViewModels.AdminDashboardViewModel

@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="container-fluid py-4">

    <div class="mb-4">
        <h2>Admin Dashboard</h2>
        <p class="text-muted">
            Platform overview and management.
        </p>
    </div>

    <div class="row g-4 mb-4">

        <div class="col-md-3">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h6 class="text-muted">Customers</h6>
                    <h3>@Model.TotalCustomers</h3>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h6 class="text-muted">Stores</h6>
                    <h3>@Model.TotalStores</h3>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h6 class="text-muted">Riders</h6>
                    <h3>@Model.TotalRiders</h3>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h6 class="text-muted">Orders</h6>
                    <h3>@Model.TotalOrders</h3>
                </div>
            </div>
        </div>

    </div>

    <div class="row g-4 mb-4">

        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h6 class="text-muted">Today's Revenue</h6>
                    <h3>@Model.TodayRevenue.ToString("C")</h3>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h6 class="text-muted">Pending Store Approvals</h6>
                    <h3>@Model.PendingStoreApprovals</h3>

                    <a asp-action="Stores"
                       class="btn btn-outline-primary btn-sm">
                        View Stores
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h6 class="text-muted">Pending Rider Approvals</h6>
                    <h3>@Model.PendingRiderApprovals</h3>

                    <a asp-action="Riders"
                       class="btn btn-outline-primary btn-sm">
                        View Riders
                    </a>
                </div>
            </div>
        </div>

    </div>

    <div class="card shadow-sm">

        <div class="card-header">
            <h5 class="mb-0">Recent Orders</h5>
        </div>

        <div class="card-body p-0">

            @if (Model.RecentOrders != null && Model.RecentOrders.Any())
            {
                <div class="table-responsive">

                    <table class="table table-hover mb-0">

                        <thead>
                            <tr>
                                <th>Order</th>
                                <th>Customer</th>
                                <th>Store</th>
                                <th>Rider</th>
                                <th>Total</th>
                                <th>Status</th>
                                <th></th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var order in Model.RecentOrders)
                            {
                                <tr>
                                    <td>@order.OrderNumber</td>
                                    <td>@order.CustomerName</td>
                                    <td>@order.StoreName</td>
                                    <td>@order.RiderName</td>
                                    <td>@order.Total.ToString("C")</td>
                                    <td>@order.Status</td>
                                    <td>
                                        <a asp-action="OrderDetails"
                                           asp-route-id="@order.OrderId"
                                           class="btn btn-sm btn-outline-primary">
                                            View
                                        </a>
                                    </td>
                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="p-4 text-center text-muted">
                    No recent orders found.
                </div>
            }

        </div>
    </div>
</div>
