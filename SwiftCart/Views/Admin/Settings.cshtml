
@model SwiftCart.ViewModels.AdminSettingsViewModel

@{
    ViewData["Title"] = "Settings";
}

<div class="container py-4">

    <h2 class="mb-4">Platform Settings</h2>

    <form asp-action="Settings"
          method="post">

        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly"
             class="alert alert-danger"></div>

        <div class="card shadow-sm">

            <div class="card-body">

                <div class="mb-3">

                    <label asp-for="PlatformName"
                           class="form-label"></label>

                    <input asp-for="PlatformName"
                           class="form-control">

                </div>

                <div class="mb-3">

                    <label asp-for="SupportEmail"
                           class="form-label"></label>

                    <input asp-for="SupportEmail"
                           class="form-control">

                </div>

                <div class="mb-3">

                    <label asp-for="SupportPhone"
                           class="form-label"></label>

                    <input asp-for="SupportPhone"
                           class="form-control">

                </div>

                <div class="form-check">

                    <input asp-for="AllowNewStoreRegistrations"
                           class="form-check-input">

                    <label asp-for="AllowNewStoreRegistrations"
                           class="form-check-label">
                        Allow new store registrations
                    </label>

                </div>

            </div>

            <div class="card-footer">

                <button class="btn btn-primary">
                    Save Settings
                </button>

            </div>

        </div>

    </form>
</div>
