@model SwiftCart.ViewModels.AdminStoresViewModel

@{
    ViewData["Title"] = "Stores";
}

<div class="container-fluid py-4">

    <h2 class="mb-4">Stores</h2>

    <div class="card shadow-sm">

        <div class="card-body p-0">

            <div class="table-responsive">

                <table class="table table-hover mb-0">

                    <thead>
                        <tr>
                            <th>Store</th>
                            <th>Owner</th>
                            <th>Status</th>
                            <th>Created</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var store in Model.Stores)
                        {
                            <tr>

                                <td>@store.StoreName</td>

                                <td>@store.OwnerName</td>

                                <td>
                                    <span class="badge bg-secondary">
                                        @store.Status
                                    </span>
                                </td>

                                <td>@store.CreatedDate</td>

                                <td>

                                    <div class="d-flex gap-1">

                                        <a asp-action="StoreDetails"
                                           asp-route-id="@store.StoreId"
                                           class="btn btn-sm btn-outline-primary">
                                            View
                                        </a>

                                        @if (store.CanApprove)
                                        {
                                            <form asp-action="ApproveStore"
                                                  method="post">

                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="id"
                                                       value="@store.StoreId">

                                                <button class="btn btn-sm btn-success">
                                                    Approve
                                                </button>

                                            </form>
                                        }

                                        @if (store.CanReject)
                                        {
                                            <form asp-action="RejectStore"
                                                  method="post">

                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="id"
                                                       value="@store.StoreId">

                                                <button class="btn btn-sm btn-danger">
                                                    Reject
                                                </button>

                                            </form>
                                        }

                                        @if (store.CanSuspend)
                                        {
                                            <form asp-action="SuspendStore"
                                                  method="post">

                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="id"
                                                       value="@store.StoreId">

                                                <button class="btn btn-sm btn-warning">
                                                    Suspend
                                                </button>

                                            </form>
                                        }

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>
    </div>
</div>
