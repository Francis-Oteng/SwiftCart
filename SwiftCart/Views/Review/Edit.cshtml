@model SwiftCart.ViewModels.EditReviewViewModel

@{
    ViewData["Title"] = "Edit Review";
}

<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-md-7">

            <div class="card shadow-sm">

                <div class="card-body p-4">

                    <h2>Edit Review</h2>

                    <p class="text-muted">
                        @Model.StoreName
                    </p>

                    <form asp-action="Edit"
                          method="post">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               asp-for="ReviewId">

                        <div asp-validation-summary="ModelOnly"
                             class="alert alert-danger"></div>

                        <div class="mb-4">

                            <label asp-for="Rating"
                                   class="form-label">
                                Rating
                            </label>

                            <select asp-for="Rating"
                                    class="form-select">

                                @foreach (var rating in Model.RatingOptions)
                                {
                                    <option value="@rating.Value">
                                        @rating.Text
                                    </option>
                                }

                            </select>

                        </div>

                        <div class="mb-4">

                            <label asp-for="Comment"
                                   class="form-label">
                                Comment
                            </label>

                            <textarea asp-for="Comment"
                                      class="form-control"
                                      rows="6"></textarea>

                        </div>

                        <button class="btn btn-primary">
                            Save Changes
                        </button>

                        <a asp-action="MyReviews"
                           class="btn btn-outline-secondary">
                            Cancel
                        </a>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
