@using SwiftCart.Models.ViewModels;
@model SwiftCart.Models.ViewModels.CreateReviewViewModel

@{
    ViewData["Title"] = "Create Review";
}

<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-md-7">

            <div class="card shadow-sm">

                <div class="card-body p-4">

                    <h2 class="mb-2">Rate Your Order</h2>

                    <p class="text-muted">
                        @Model.StoreName
                    </p>

                    <form asp-action="Create"
                          method="post">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               asp-for="OrderId">

                        <input type="hidden"
                               asp-for="StoreId">

                        <div asp-validation-summary="ModelOnly"
                             class="alert alert-danger"></div>

                        <div class="mb-4">

                            <label asp-for="Rating"
                                   class="form-label">
                                Rating
                            </label>

                            <select asp-for="Rating"
                                    class="form-select">

                                @foreach (var rating in Model.RatingOptions)
                                {
                                    <option value="@rating.Value">
                                        @rating.Text
                                    </option>
                                }

                            </select>

                            <span asp-validation-for="Rating"
                                  class="text-danger"></span>

                        </div>

                        <div class="mb-4">

                            <label asp-for="Comment"
                                   class="form-label">
                                Your Experience
                            </label>

                            <textarea asp-for="Comment"
                                      class="form-control"
                                      rows="6"></textarea>

                            <span asp-validation-for="Comment"
                                  class="text-danger"></span>

                        </div>

                        <button type="submit"
                                class="btn btn-primary">
                            Submit Review
                        </button>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
