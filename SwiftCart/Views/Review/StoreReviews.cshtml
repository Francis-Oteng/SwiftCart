@using SwiftCart.Models.ViewModels;
@model SwiftCart.Models.ViewModels.StoreReviewsViewModel

@{
    ViewData["Title"] = "Store Reviews";
}

<div class="container py-4">

    <div class="mb-4">

        <h2>@Model.StoreName</h2>

        <div class="d-flex align-items-center gap-2">

            <span class="text-warning">

                @for (var i = 1; i <= Math.Round(Model.AverageRating); i++)
                {
                    <i class="fas fa-star"></i>
                }

            </span>

            <strong>
                @Model.AverageRating.ToString("0.0")
            </strong>

            <span class="text-muted">
                (@Model.TotalReviews reviews)
            </span>

        </div>

    </div>

    @if (Model.Reviews != null && Model.Reviews.Any())
    {
        <div class="row g-4">

            @foreach (var review in Model.Reviews)
            {
                <div class="col-md-6">

                    <div class="card shadow-sm">

                        <div class="card-body">

                            <div class="d-flex justify-content-between">

                                <strong>
                                    @review.CustomerName
                                </strong>

                                <small class="text-muted">
                                    @review.CreatedDate
                                </small>

                            </div>

                            <div class="text-warning my-2">

                                @for (var i = 1; i <= review.Rating; i++)
                                {
                                    <i class="fas fa-star"></i>
                                }

                            </div>

                            <p class="mb-0">
                                @review.Comment
                            </p>

                        </div>

                    </div>

                </div>
            }

        </div>
    }
    else
    {
        <div class="alert alert-info">
            This store has no reviews yet.
        </div>
    }

</div>
