@model SwiftCart.ViewModels.StoreFormViewModel
@{
    ViewData["Title"] = "Edit Store";
}

<div class="container py-4">
    <h2>Edit Store</h2>

    <form asp-action="Edit" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <input asp-for="StoreId" type="hidden" />
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <partial name="_StoreForm" model="Model" />

        <button class="btn btn-primary mt-3">Save Changes</button>
        <a asp-action="MyStore" class="btn btn-outline-secondary mt-3">Cancel</a>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}