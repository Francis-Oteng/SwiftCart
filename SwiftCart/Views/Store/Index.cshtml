@model SwiftCart.ViewModels.StoreListViewModel
@{
    ViewData["Title"] = "Stores";
}

<div class="container py-4">
    <h2 class="mb-4">Browse Stores</h2>

    <form asp-action="Index" method="get" class="input-group mb-4">
        <input name="search" value="@Model.Search" class="form-control"
               placeholder="Search stores..." />
        <button class="btn btn-primary">Search</button>
    </form>

    <div class="row g-4">
        @foreach (var store in Model.Stores)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 shadow-sm">
                    @if (!string.IsNullOrWhiteSpace(store.LogoUrl))
                    {
                        <img src="@store.LogoUrl" alt="@store.Name"
                             class="card-img-top"
                             style="height:180px;object-fit:cover;" />
                    }
                    <div class="card-body">
                        <h5>@store.Name</h5>
                        <p class="text-muted">@store.Location</p>
                        <p>@store.Description</p>
                        <a asp-action="Details" asp-route-id="@store.StoreId"
                           class="btn btn-outline-primary">View Store</a>
                    </div>
                </div>
            </div>
        }
    </div>

    @if (!Model.Stores.Any())
    {
        <p class="text-muted">No stores are currently available.</p>
    }
</div>




