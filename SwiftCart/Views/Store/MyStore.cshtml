@model SwiftCart.ViewModels.MyStoreViewModel
@{
    ViewData["Title"] = "My Store";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>My Store</h2>
        @if (Model.Store != null)
        {
            <a asp-action="Edit" asp-route-id="@Model.Store.StoreId"
               class="btn btn-primary">Edit Store</a>
        }
    </div>

    @if (Model.Store != null)
    {
        <div class="card shadow-sm"><div class="card-body">
            <h4>@Model.Store.Name</h4>
            <p>@Model.Store.Description</p>
            <p>Location: @Model.Store.Location</p>
            <p>Status: @Model.Store.Status</p>
            <a asp-action="Orders" class="btn btn-outline-primary">Manage Orders</a>
            <a asp-controller="Product" asp-action="MyProducts"
               class="btn btn-outline-secondary">Manage Products</a>
        </div></div>
    }
    else
    {
        <div class="alert alert-info">
            You have not created a store yet.
            <a asp-action="Create">Create your store</a>
        </div>
    }
</div>
