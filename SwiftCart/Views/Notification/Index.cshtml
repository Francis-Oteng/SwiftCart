### `Views/Notification/Index.cshtml`

```cshtml
@model SwiftCart.ViewModels.NotificationListViewModel

@{
    ViewData["Title"] = "Notifications";
}

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2>Notifications</h2>

            <p class="text-muted mb-0">
                Your latest notifications.
            </p>
        </div>

        @if (Model.Notifications != null && Model.Notifications.Any(n => !n.IsRead))
        {
            <form asp-action="MarkAllAsRead"
                  method="post">

                @Html.AntiForgeryToken()

                <button class="btn btn-outline-primary">
                    Mark all as read
                </button>

            </form>
        }

    </div>

    <div class="card shadow-sm">

        <div class="card-body p-0">

            @if (Model.Notifications != null && Model.Notifications.Any())
            {
                @foreach (var notification in Model.Notifications)
                {
                    <div class="p-4 border-bottom @(notification.IsRead ? "" : "bg-light")">

                        <div class="d-flex justify-content-between">

                            <div>

                                <h6 class="mb-1">
                                    @notification.Title
                                </h6>

                                <p class="mb-1">
                                    @notification.Message
                                </p>

                                <small class="text-muted">
                                    @notification.CreatedDate
                                </small>

                            </div>

                            @if (!notification.IsRead)
                            {
                                <form asp-action="MarkAsRead"
                                      method="post">

                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="id"
                                           value="@notification.NotificationId">

                                    <button class="btn btn-sm btn-outline-primary">
                                        Mark as read
                                    </button>

                                </form>
                            }

                        </div>

                    </div>
                }
            }
            else
            {
                <div class="p-5 text-center text-muted">

                    <i class="fas fa-bell-slash fa-3x mb-3"></i>

                    <p class="mb-0">
                        You have no notifications.
                    </p>

                </div>
            }

        </div>
    </div>
</div>

