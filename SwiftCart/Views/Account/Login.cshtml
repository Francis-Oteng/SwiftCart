@using SwiftCart.Models.ViewModels.Account;
@using SwiftCart.Models.ViewModels.Account
@model SwiftCart.Models.ViewModels.Account.LoginViewModel

@{
    ViewData["Title"] = "Login";
    Layout = "_SignInLayout";
}

<div class="login-form">

    <div class="mb-4">
        <h2 class="login-title">Welcome Back</h2>

        <p class="login-subtitle">
            Sign in to your SwiftCart account to continue shopping.
        </p>
    </div>

    <form asp-action="Login" method="post">

        @Html.AntiForgeryToken()

        <input type="hidden" asp-for="ReturnUrl" />

        <div asp-validation-summary="ModelOnly"
             class="text-danger mb-3">
        </div>


        <!-- Email -->
        <div class="mb-4">

            <label asp-for="Email" class="form-label">
                Email Address
            </label>

            <input asp-for="Email"
                   class="form-control form-control-lg"
                   placeholder="Enter your email address"
                   autocomplete="username" />

            <span asp-validation-for="Email"
                  class="text-danger">
            </span>

        </div>


        <!-- Password -->
        <div class="mb-3">

            <div class="d-flex justify-content-between align-items-center">

                <label asp-for="Password" class="form-label mb-2">
                    Password
                </label>

                <a asp-action="ForgotPassword"
                   class="forgot-password">
                    Forgot password?
                </a>

            </div>

            <input asp-for="Password"
                   type="password"
                   class="form-control form-control-lg"
                   placeholder="Enter your password"
                   autocomplete="current-password" />

            <span asp-validation-for="Password"
                  class="text-danger">
            </span>

        </div>


        <!-- Remember me -->
        <div class="form-check mb-4">

            <input asp-for="RememberMe"
                   class="form-check-input" />

            <label asp-for="RememberMe"
                   class="form-check-label">
                Remember me
            </label>

        </div>


        <!-- Login button -->
        <button type="submit"
                class="btn btn-signin btn-lg w-100">

            <i class="bi bi-box-arrow-in-right me-2"></i>

            Sign In

        </button>

    </form>


    <!-- Register -->
    <div class="text-center mt-4">

        <span class="text-muted">
            Don't have an account?
        </span>

        <a asp-action="Register"
           class="signin-link">
            Create an account
        </a>

    </div>

</div>


<style>

    .login-form {
        width: 100%;
        max-width: 480px;
        margin: 0 auto;
    }

    .login-title {
        font-size: 32px;
        font-weight: 800;
        color: #212529;
        margin-bottom: 8px;
    }

    .login-subtitle {
        color: #6c757d;
        font-size: 15px;
        margin-bottom: 0;
        line-height: 1.6;
    }

    .form-label {
        font-weight: 600;
        font-size: 15px;
        color: #343a40;
        margin-bottom: 8px;
    }

    .form-control {
        min-height: 56px;
        border-radius: 10px;
        padding: 14px 16px;
        font-size: 16px;
        border: 1px solid #dee2e6;
    }

        .form-control:focus {
            border-color: #198754;
            box-shadow: 0 0 0 0.2rem rgba(25, 135, 84, 0.15);
        }

    .forgot-password {
        color: #198754;
        text-decoration: none;
        font-size: 14px;
        font-weight: 600;
    }

        .forgot-password:hover {
            text-decoration: underline;
        }

    .form-check-input {
        width: 18px;
        height: 18px;
        margin-top: 3px;
    }

    .form-check-label {
        margin-left: 5px;
        color: #495057;
    }

    .btn-signin {
        min-height: 56px;
        border-radius: 10px;
        font-size: 16px;
        font-weight: 700;
    }

    .signin-link {
        color: #198754;
        text-decoration: none;
        font-weight: 600;
    }

        .signin-link:hover {
            text-decoration: underline;
        }

</style>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}