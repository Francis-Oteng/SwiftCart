@using SwiftCart.Models.ViewModels.Account;
@model SwiftCart.Models.ViewModels.Account.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot Password";
    Layout = "_SignInLayout";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-body p-4">
                    <h2>Forgot Password?</h2>
                    <p class="text-muted">
                        Enter your email to request password-reset instructions.
                    </p>

                    <form asp-action="ForgotPassword" method="post">
                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label"></label>
                            <input asp-for="Email" class="form-control"
                                   autocomplete="email" />
                            <span asp-validation-for="Email"
                                  class="text-danger"></span>
                        </div>

                        <button type="submit" class="btn btn-primary w-100">
                            Request Reset
                        </button>
                    </form>

                    <a asp-action="Login" class="d-inline-block mt-3">
                        Back to login
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

