<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - SwiftCart</title>

    <!-- Bootstrap -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <!-- Bootstrap Icons -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <!-- Google Font -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
          rel="stylesheet" />

    <style>
            * {
                box-sizing: border-box;
            }

            body {
                margin: 0;
                min-height: 100vh;
                font-family: 'Inter', sans-serif;
                background: #f5f7f5;
            }

            .signin-wrapper {
                min-height: 100vh;
                display: flex;
                align-items: center;
                justify-content: center;
                padding: 30px 15px;
            }

            .signin-container {
                width: 100%;
                max-width: 1100px;
                min-height: 650px;
                display: grid;
                grid-template-columns: 1fr 1fr;
                background: #ffffff;
                border-radius: 24px;
                overflow: hidden;
                box-shadow: 0 15px 50px rgba(0, 0, 0, 0.10);
            }

            /* Left side */
            .signin-brand {
                background: linear-gradient(135deg, #198754, #126b42);
                color: white;
                padding: 60px;
                display: flex;
                flex-direction: column;
                justify-content: center;
                position: relative;
                overflow: hidden;
            }

                .signin-brand::before {
                    content: "";
                    position: absolute;
                    width: 300px;
                    height: 300px;
                    border-radius: 50%;
                    background: rgba(255, 255, 255, 0.08);
                    top: -100px;
                    right: -100px;
                }

                .signin-brand::after {
                    content: "";
                    position: absolute;
                    width: 250px;
                    height: 250px;
                    border-radius: 50%;
                    background: rgba(255, 255, 255, 0.06);
                    bottom: -100px;
                    left: -100px;
                }

            .brand-content {
                position: relative;
                z-index: 1;
            }

            .brand-logo {
                display: flex;
                align-items: center;
                gap: 12px;
                margin-bottom: 40px;
            }

            .brand-logo-icon {
                width: 50px;
                height: 50px;
                border-radius: 14px;
                background: white;
                color: #198754;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 25px;
            }

            .brand-logo h1 {
                margin: 0;
                font-size: 28px;
                font-weight: 800;
            }

            .signin-brand h2 {
                font-size: 38px;
                line-height: 1.2;
                font-weight: 800;
                margin-bottom: 20px;
            }

            .signin-brand p {
                font-size: 16px;
                line-height: 1.7;
                opacity: 0.9;
                max-width: 450px;
            }

            .feature-list {
                margin-top: 35px;
            }

            .feature-item {
                display: flex;
                align-items: center;
                gap: 12px;
                margin-bottom: 18px;
                font-size: 15px;
            }

            .feature-icon {
                width: 34px;
                height: 34px;
                border-radius: 50%;
                background: rgba(255, 255, 255, 0.15);
                display: flex;
                align-items: center;
                justify-content: center;
            }

            /* Right side */
            .signin-form-section {
                padding: 60px;
                display: flex;
                flex-direction: column;
                justify-content: center;
            }

            .signin-form-container {
                width: 100%;
                max-width: 430px;
                margin: 0 auto;
            }

                .signin-form-container h2 {
                    font-size: 30px;
                    font-weight: 800;
                    color: #212529;
                    margin-bottom: 8px;
                }

            .signin-subtitle {
                color: #6c757d;
                margin-bottom: 30px;
            }

            .form-label {
                font-weight: 600;
                color: #343a40;
            }

            .form-control {
                min-height: 50px;
                border-radius: 10px;
                border: 1px solid #dee2e6;
                padding: 12px 15px;
            }

                .form-control:focus {
                    border-color: #198754;
                    box-shadow: 0 0 0 0.2rem rgba(25, 135, 84, 0.15);
                }

            .btn-signin {
                width: 100%;
                min-height: 50px;
                border: none;
                border-radius: 10px;
                background: #198754;
                color: white;
                font-weight: 700;
                transition: 0.2s ease;
            }

                .btn-signin:hover {
                    background: #146c43;
                    color: white;
                    transform: translateY(-1px);
                }

            .signin-link {
                color: #198754;
                text-decoration: none;
                font-weight: 600;
            }

                .signin-link:hover {
                    text-decoration: underline;
                }

            .validation-summary-errors {
                color: #dc3545;
                font-size: 14px;
                margin-bottom: 15px;
            }

            .field-validation-error {
                color: #dc3545;
                font-size: 13px;
            }

            .footer-text {
                text-align: center;
                color: #6c757d;
                font-size: 13px;
                margin-top: 25px;
            }

            /* Mobile */
            @@media (max-width: 768px) {
                .signin-container {
                    grid-template-columns: 1fr;
                    min-height: auto;
                }

                .signin-brand {
                    padding: 40px 30px;
                }

                    .signin-brand h2 {
                        font-size: 30px;
                    }

                .feature-list {
                    margin-top: 25px;
                }

                .signin-form-section {
                    padding: 40px 25px;
                }
            }
    </style>
</head>

<body>

    <div class="signin-wrapper">

        <div class="signin-container">

            <!-- Branding -->
            <section class="signin-brand">

                <div class="brand-content">

                    <div class="brand-logo">

                        <div class="brand-logo-icon">
                            <i class="bi bi-cart3"></i>
                        </div>

                        <h1>SwiftCart</h1>

                    </div>

                    <h2>
                        Groceries delivered
                        <br />
                        straight to you.
                    </h2>

                    <p>
                        Shop fresh groceries from trusted local stores
                        and have everything delivered quickly and conveniently.
                    </p>

                    <div class="feature-list">

                        <div class="feature-item">
                            <span class="feature-icon">
                                <i class="bi bi-shop"></i>
                            </span>
                            <span>Shop from local stores</span>
                        </div>

                        <div class="feature-item">
                            <span class="feature-icon">
                                <i class="bi bi-truck"></i>
                            </span>
                            <span>Fast and reliable delivery</span>
                        </div>

                        <div class="feature-item">
                            <span class="feature-icon">
                                <i class="bi bi-geo-alt"></i>
                            </span>
                            <span>Track your delivery</span>
                        </div>

                    </div>

                </div>

            </section>


            <!-- Form -->
            <section class="signin-form-section">

                <div class="signin-form-container">

                    @RenderBody()

                    <div class="footer-text">
                        &copy; @DateTime.Now.Year SwiftCart.
                        All rights reserved.
                    </div>

                </div>

            </section>

        </div>

    </div>


    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
    </script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>